# Copy this file to .env and fill in real values for local development.
# .env is gitignored and must never be committed to source control.

# PostgreSQL connection string
# Local Windows dev:  postgresql://dwh:DBTTEST@localhost:5432/dwh
# Docker Compose:     postgresql://dwh:<password>@db:5432/dwh
DATABASE_URL=postgresql://dwh:DBTTEST@localhost:5432/dwh

# Flask session signing key — set a long random string in staging/production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# PostgreSQL password (used by docker-compose to initialise the DB container)
# Must match the password in DATABASE_URL above.
POSTGRES_PASSWORD=DBTTEST
